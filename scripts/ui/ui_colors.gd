## Дизайн-токены Dark Omens.
## Используй семантические токены (ACCENT, DANGER, …) — не примитивы.
## При смене темы меняй только примитивы — токены подхватят автоматически.
class_name UIColors

# ── Примитивы ──────────────────────────────────────────────────────────────────
# Не используй напрямую в коде сцен/скриптов.

const _VOID := Color(0.05, 0.04, 0.10)
const _SURFACE := Color(0.08, 0.07, 0.15)
const _COPPER := Color(0.35, 0.25, 0.10)
const _AMBER := Color(0.78, 0.66, 0.29)
const _CRIMSON := Color(0.55, 0.10, 0.10)
const _HEART := Color(0.61, 0.24, 0.19)  # яркий тон иконки здоровья (сэмпл health-icon.png)
const _STONE := Color(0.85, 0.82, 0.75)
const _ASH := Color(0.55, 0.52, 0.45)
const _SCARLET := Color(0.90, 0.25, 0.20)
const _JADE := Color(0.30, 0.80, 0.40)
const _TOPAZ := Color(0.90, 0.75, 0.20)
const _FOREST := Color(0.20, 0.70, 0.35)
const _BRONZE := Color("c39b6a")
const _ONYX := Color(0.10, 0.09, 0.18)
const _PITCH := Color(0.10, 0.08, 0.14)
const _SOOT := Color(0.055, 0.052, 0.045)  # тёплая сажа — плотные подложки поверх арта
const _SEPIA := Color(0.16, 0.11, 0.06)  # тушь на пергаменте
const _PARCHMENT := Color(0.92, 0.87, 0.77)  # светлый пергамент — текст на тёмной плашке
const _STEEL := Color(0.275, 0.510, 0.706)  # #4682B4 — морской путь
const _RUST := Color(0.627, 0.322, 0.176)  # #A0522D — железная дорога

# ── Структура ──────────────────────────────────────────────────────────────────

const BG := _VOID  ## фон сцены
const SURFACE := _SURFACE  ## фон панелей и карточек
const BORDER := _COPPER  ## рамки по умолчанию, разделители
const CONTROL := _ONYX  ## фон контролов (кнопки/дропдауны/поля)
const ART_BG := _PITCH  ## тёмная подложка арт-слота карты/жетона
const PLAQUE_BG := Color(_SOOT, 0.97)  ## плотная подложка: подсказка, иконка кнопки, плашка

# ── Типографика ────────────────────────────────────────────────────────────────

const TEXT := _STONE  ## основной текст
const MUTED := _ASH  ## второстепенный текст, подсказки, disabled
const VALUE := _BRONZE  ## числовые значения: атрибуты, счётчики (улики/ресурсы/концентрация)
const IMPAIR := _HEART  ## ухудшение навыка/шрам (−n) — в цвет иконки здоровья, читаемее crimson
const INK := _SEPIA  ## текст на пергаменте: табличка галереи, телеграмма, фраза на карте
const TEXT_BRIGHT := _PARCHMENT  ## светлый текст на тёмной плашке (плашки действий, иконки)

# ── Роли действий ──────────────────────────────────────────────────────────────

const ACCENT := _AMBER  ## заголовки, основные CTA, иконка хоста
const DANGER := _CRIMSON  ## деструктивные действия (удалить, покинуть)
const SUBTLE := _ASH  ## вторичные / ghost-действия

# ── Семантические состояния ────────────────────────────────────────────────────

const SUCCESS := _JADE  ## подключено, найдено, вход выполнен
const WARNING := _TOPAZ  ## загрузка, ожидание, переподключение
const ERROR := _SCARLET  ## ошибка, потеря соединения

# ── Игровые состояния ─────────────────────────────────────────────────────────

const READY := _FOREST  ## игрок готов, игру можно начинать
const WILL := Color(0.4, 0.7, 0.9)  ## ужас монстра / шаг Воли в бою (синий)
const STRENGTH := _SCARLET  ## урон монстра / шаг Силы в бою (красный)
const ROUTE_SHIP := _STEEL  ## морской путь и билет на корабль
const ROUTE_TRAIN := _RUST  ## железная дорога и билет на поезд

# ── Модуляты (множители modulate, не базовые цвета) ─────────────────────────────

const HIGHLIGHT := Color(1.12, 1.12, 1.12)  ## наведение/актив — лёгкий брайтенинг
## Цвет АКТИВНОГО выделения — единый для всего, что «сейчас выбрано / сейчас ходит»:
## выбранная локация (кольцо и стрелка), ореол пина того, кто ходит, ореол своей
## аватарки в свой ход. Поменять оттенок выделения во всей игре — здесь.
const ACTIVE := Color(0.561, 0.741, 0.302)
const DISABLED := Color(0.5, 0.5, 0.5, 0.7)  ## неактивно/недоступно — приглушение
