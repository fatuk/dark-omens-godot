// Зерно поверх карты — то же, что «Add Noise» в фотошопе (Gaussian, Monochromatic),
// но процедурное. Считается в ЭКРАННЫХ координатах, поэтому:
//   • не ползёт при панорамировании (запечённое зерно плыло из-за билинейной выборки);
//   • не мельчает и не мылится на отдалении — размер зерна всегда в пикселях экрана;
//   • ассет карты остаётся гладким и жмётся в 4 раза лучше.
shader_type canvas_item;

uniform float amount : hint_range(0.0, 0.15) = 0.03;  // как Amount в фотошопе (3% = 0.03)
uniform float grain_size : hint_range(0.5, 4.0) = 1.0;  // сторона зерна в пикселях экрана


float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

void fragment() {
	vec2 cell = floor(FRAGCOORD.xy / grain_size);
	// Преобразование Бокса—Мюллера: из двух равномерных чисел — нормальное
	// распределение (у фотошопа Distribution: Gaussian). sigma = 1, поэтому
	// amount читается напрямую как доля полного диапазона яркости.
	float u1 = max(hash(cell), 1e-6);
	float u2 = hash(cell + 17.0);
	float g = sqrt(-2.0 * log(u1)) * cos(6.2831853 * u2);
	// Monochromatic: одно и то же смещение во все каналы.
	// COLOR на входе canvas_item-шейдера — УЖЕ сэмпл текстуры (с фильтром и
	// мипмапом), поэтому именно прибавляем, а не домножаем.
	COLOR.rgb = clamp(COLOR.rgb + vec3(g * amount), 0.0, 1.0);
}
