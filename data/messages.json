	"languages": ["en", "ru"],
	"placeholder": {
	  "noun": "{noun}",
	  "noun2": "{noun2}",
	  "note": "Substitute a noun's display field for each placeholder. {noun} may appear more than once (invocation_double) — fill all occurrences with the SAME noun. {noun2} is a second, different noun."
	},
	"tiers": {
	  "functional": "Coordination: yes/no, intents, requests, status. Shown first in the UI.",
	  "flavor": "Atmosphere: omens, cries, invocations. Shown in a separate tab."
	},
	"slots": "Each phrase declares how many distinct nouns it consumes: 0, 1 or 2.",
	"grammar_invariant": [
	  "All nouns are stored in nominative singular (dictionary) form; every phrase keeps the slot in the nominative case.",
	  "Functional phrases contain no verb that agrees with the slot (telegraph style: 'Иду: {noun}', '{noun} на исходе'), so ANY noun fits ANY functional phrase.",
      "Flavor phrases with a verb agree in number. Nouns that are plural in a language declare it in `pl`; such phrases provide `en_pl` / `ru_pl`. Renderer: if noun.pl contains lang and phrase has {lang}_pl, use it; otherwise use {lang}."
	],
	"punctuation_modifiers": {
	  "note": "Applied by the renderer to any phrase; not stored as separate phrases.",
	  "values": [".", "?", "!", "…"]
	},
	"ids_are_english": "Phrase and noun `id` values are stable code identifiers; only `en`/`ru` are human-readable.",
	"categories": "`phrase_categories` / `noun_categories` define the UI order of sections (top to bottom = first to last) and their localized titles. Categories used by entries but not listed here are appended at the end with the id as title."
  },

