{
  "_meta": {
	"name": "Dark Omens — Message Dictionary",
	"version": "0.1.0",
	"languages": ["en", "ru"],
	"placeholder": {
	  "noun": "{noun}",
	  "noun2": "{noun2}",
	  "note": "Substitute a noun's display field for each placeholder. {noun} may appear more than once (e.g. invocation_double) — fill all occurrences with the SAME chosen noun. {noun2} is a second, different noun."
	},
	"grammar_invariant": [
	  "All RU nouns are stored in nominative singular (dictionary) form.",
	  "Every phrase keeps the slot in the nominative case, and all RU verbs are present/future tense (no gender agreement).",
	  "Therefore ANY noun x ANY phrase is grammatically correct in both languages — no per-case or per-gender forms are needed.",
      "This mirrors how English avoids declension; it is the deliberate design choice that lets the dictionary stay flat."
	],
	"ids_are_english": "Phrase and noun `id` values are stable code identifiers and stay in English; only `en`/`ru` are human-readable.",
	"slots": "Each phrase declares how many distinct nouns it consumes (1 or 2)."
  },

