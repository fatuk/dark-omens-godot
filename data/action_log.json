		],
		"purpose": "Transient 'action feed': every investigator's standard action is broadcast as a short literary bubble over their map pin, so waiting players can read what others are doing. Mirrors the chat bubble system but the text is auto-generated from the action, not player-composed.",
		"placeholders": {
			"place": "{place}",
			"monster": "{monster}",
			"condition": "{condition}",
			"note": "Placeholder values are i18n KEYS (LOC_*_NAME / MONSTER_*_NAME / COND_*_NAME), resolved on each client via TranslationServer in its own locale. Never send pre-rendered text."
		},
		"style": [
			"No investigator name — the bubble floats over the actor's pin, so who is already obvious (Dark Souls feel).",
			"Third person, terse, atmospheric.",
			"Proper-noun params appear as NOMINATIVE appositions set off by punctuation (ellipsis / period), e.g. ru 'Держит путь… {place}.' — this stays grammatically valid for any RU name regardless of gender/case, matching the grammar-invariant design of the chat dictionary.",
			"ids stay in English (stable code identifiers); only en/ru are human-readable."
		]
	},
